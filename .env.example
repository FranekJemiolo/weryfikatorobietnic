# Airflow Core Settings
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.2-python3.11
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# PostgreSQL Database (Airflow Meta & Application Data)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Application Specific DB Settings
APP_DB_NAME=weryfikator_db
DATABASE_URL=postgresql://airflow:airflow@postgres:5432/weryfikator_db

# External APIs
SEJM_API_BASE_URL=https://api.sejm.gov.pl/sejm
DEFAULT_SEJM_TERM=10

# LLM Providers (Vertex AI / OpenAI / Gemini)
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
